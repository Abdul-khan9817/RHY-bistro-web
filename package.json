{
  "name": "rhy-bistro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @workspace/server --filter @workspace/rhy-bistro dev",
    "dev:client": "pnpm --filter @workspace/rhy-bistro dev",
    "dev:server": "pnpm --filter @workspace/server dev",
    "build": "pnpm -r --if-present run build",
    "start": "pnpm --filter @workspace/server start",
    "seed": "pnpm --filter @workspace/server seed",
    "typecheck": "tsc --build && pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
