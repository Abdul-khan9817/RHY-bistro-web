# ─────────────────────────────────────────────
# RHY Bistro — Server Environment Variables
# Copy this file to .env and fill in real values
# ─────────────────────────────────────────────

# Database
MONGODB_URI=mongodb://localhost:27017/rhy-bistro
DB_NAME=rhy-bistro

# Server
PORT=3001
NODE_ENV=development

# Security — MUST be changed before production deployment
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOMBYTES_48

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=yourpassword
SMTP_FROM="BACCHUS RHY Bistro <noreply@rhybistro.ch>"
ADMIN_EMAIL=admin@rhybistro.ch
